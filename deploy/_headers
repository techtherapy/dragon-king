# Cloudflare Pages headers — copied to the output root by scripts/build_site.sh

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Artwork and fonts are regenerated rarely; a week of caching is safe.
/assets/*
  Cache-Control: public, max-age=604800
