# Cloudflare Pages headers — copied to the output root by scripts/build_site.sh

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Artwork is regenerated rarely; a week of caching is safe. The rules below
# must not overlap: Cloudflare CONCATENATES matching rules rather than letting a
# later one win, so /assets/* plus /assets/*.woff2 produced a single malformed
# header carrying two max-age values. Each extension is listed once instead.
/assets/*.svg
  Cache-Control: public, max-age=604800
/assets/*.jpg
  Cache-Control: public, max-age=604800
/assets/*.png
  Cache-Control: public, max-age=604800
/assets/*.txt
  Cache-Control: public, max-age=604800

# The subset font's filename carries a content stamp, so a rebuild produces a
# new name and this copy can never go stale — cache it for a year.
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The stylesheets and scripts have unversioned filenames, so a long max-age
# would strand readers on the previous deploy's CSS. An hour fresh, then served
# stale while a new copy is fetched in the background — the caching benefit
# without the staleness. (A content hash in the filename would allow a year.)
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
